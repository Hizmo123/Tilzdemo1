// Tillz QR — core tenant schema (M1 + Drop 2 + Drop 3)
// Identity/auth is handled by Supabase Auth (auth.users). These tables are the
// application domain, keyed to the Supabase user UUID via Membership.userId.
// All money is stored as integer cents (spec §65, §106) — never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // pooled (pgbouncer) — runtime
  directUrl = env("DIRECT_URL")        // direct — migrations
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
  KITCHEN
  VIEW_ONLY
}

enum BillStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOIDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PlanTier {
  LITE
  BASIC
  GROWTH
  PRO
  // No monthly subscription — the venue's own Square account settles
  // payments and owns the kitchen (Square's POS/KDS, not Tillz's). Tillz's
  // revenue instead comes from a small per-order app fee, applied ONLY to
  // this tier — see lib/entitlements-core.ts#appFeeBps and
  // lib/square/pay.ts#chargeBillViaSquare.
  CONNECT
}

enum OrderStatus {
  PENDING
  SUBMITTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderSource {
  CUSTOMER
  STAFF
}

enum RequestType {
  WATER
  CUTLERY
  ASSISTANCE
  BILL
  OTHER
}

enum RequestStatus {
  OPEN
  ACKNOWLEDGED
  COMPLETED
}

// A billing/account boundary. One business = one organization.
model Organization {
  id          String       @id @default(cuid())
  name        String
  plan        PlanTier     @default(LITE)
  planStatus  String       @default("none")
  cardLast4   String?
  subscribedAt DateTime?
  // Set the moment a subscription lapses (payment failed / cancelled) — null
  // means current. Nothing writes this yet: real Stripe Billing webhooks
  // (Delivery 2) will, once those are connected. See lib/entitlements.ts for
  // what happens once it's set: existing service and read access keep
  // running through a grace period, and only past that does new ordering
  // stop — never an instant, mid-service cutoff.
  subscriptionLapsedAt DateTime?
  // A self-service "please delete my account" request, not an instant purge.
  // Paid bills are tax invoices — Australian tax law requires keeping those
  // for 5 years, so financial records survive this request regardless; the
  // request records the owner's intent and lets support finish the deletion
  // once that's accounted for, rather than either doing nothing or silently
  // destroying records the venue may still legally need. See lib/account.ts.
  deletionRequestedAt      DateTime?
  deletionRequestedByEmail String?
  // Self-service "pause everything" — distinct from a deletion request.
  // While set: the owner/team's dashboard login is blocked (see the check in
  // dashboard/layout.tsx) and every staff PIN login for every restaurant in
  // this org is blocked (see staffLogin in lib/staff-auth.ts). Also records
  // it as the moment the subscription was cancelled — see planStatus below.
  // Cleared only by following the emailed reactivation link, never from
  // inside the (now-inaccessible) dashboard.
  deactivatedAt               DateTime?
  deactivatedByEmail           String?
  reactivationToken            String?   @unique
  reactivationTokenExpiresAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  restaurants Restaurant[]
  memberships Membership[]
  invites     StaffInvite[]
  auditLogs   AuditLog[]
  standOrders StandOrder[]
}

// A brand/venue within an organization.
model Restaurant {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String          @unique
  abn            String?
  // Set once `abn` is confirmed against the Australian Business Register
  // (see lib/abr.ts) — a real "this is a registered business" check, unlike
  // the old phone-verification gate. abnVerifiedValue is the exact digits
  // that were verified, kept separate from `abn` itself so a later manual
  // edit to `abn` (via the plain settings form) is detected as no longer
  // matching and correctly drops the verified badge rather than carrying it
  // over onto an ABN that was never actually checked.
  abnVerifiedAt    DateTime?
  abnVerifiedValue String?
  abnVerifiedName  String?
  abnVerifiedGst   Boolean?
  venueType      String?
  // Optional contact number — NOT a verification mechanism (see
  // abnVerifiedAt for that). Nothing in the app gates on this being set.
  ownerPhone     String?
  currency       String          @default("AUD")
  timezone       String          @default("Australia/Sydney")
  // ISO 3166-1 alpha-2 (e.g. "AU"). Gates which country-specific settings show
  // up — right now that's just the tax step's ABN field (AU only); other
  // countries get a "not set up yet" placeholder until real per-country rules
  // are added. See lib/countries.ts.
  country        String          @default("AU")
  // ISO 639-1 (e.g. "en"). Only translates the fixed strings on the
  // customer-facing ordering page (see lib/languages.ts) — menu item names/
  // descriptions are whatever the owner typed, not machine-translated.
  language       String          @default("en")
  logoUrl        String?
  coverUrl       String?
  bgImageUrl     String?
  brandColor     String?
  theme          String          @default("warm")
  themeMode      String          @default("light")
  fontTheme      String          @default("classic")
  tipEnabled     Boolean         @default(false)
  tipPresets     Int[]           @default([5, 10, 15])
  customerOrdering Boolean       @default(true)
  customerPayment  Boolean       @default(true)
  // Orders from customers wait for staff to accept before hitting the kitchen.
  staffApproval    Boolean       @default(false)
  // When customers pay: "after" = running tab, pay when ready (default);
  // "before" = prepay, prompt to pay as soon as an order is placed.
  paymentTiming    String        @default("after")
  // Opt-in, stricter variant of paymentTiming "before": the customer page
  // never treats a placed-but-unpaid order as "sent to the kitchen, pay
  // whenever" — it's presented as blocked on payment, no soft skip. Only
  // meaningful when customerPayment is on; off by default, an alternative
  // alongside the normal ordering flow, not a replacement for it.
  requirePaymentBeforeOrder Boolean @default(false)
  // Monotonic per-venue counter used to allocate human order numbers.
  orderSeq         Int           @default(0)
  // Opening hours as JSON: 7 entries [{day:0..6 (0=Sun), closed:bool,
  // open:"HH:MM", close:"HH:MM"}]. Null = always open.
  hours            Json?
  // How guests typically order in this venue (table service / QR / counter /
  // mixed). Informational — doesn't itself drive settings, but is used to
  // prioritise dashboard/sidebar emphasis via experienceMode.
  serviceStyle     String?
  // The onboarding "what should Tillz do for you" preset (digital_menu /
  // order_and_pay / payment_only / custom). Drives the dashboard sidebar
  // ordering; the underlying toggles above are what actually control
  // product behaviour.
  experienceMode   String?
  // Which bill-splitting methods guests can use at checkout. Enforced
  // server-side in payBillAmount/payBillItems, not just hidden in the UI.
  splitMethods     String[]      @default(["full", "equal", "items", "custom"])
  // Whether the kitchen board chimes on a new ticket.
  kitchenChime     Boolean       @default(true)
  // Venue-defined prep station names (e.g. ["Kitchen", "Barista", "Grill"]),
  // offered as the choices in the category/item station pickers. Free text
  // stored on MenuCategory.station / MenuItem.station still works even if it
  // doesn't match one of these (e.g. legacy data, or a station since
  // renamed) — this list is just what the pickers suggest, not a foreign key.
  kitchenStations  String[]      @default(["Kitchen"])
  // Card/button corner rounding for the customer ordering page: sharp/soft/round.
  cornerStyle      String        @default("soft")
  // Optional short line shown under the venue name on the customer page.
  tagline          String?
  // How the customer menu is laid out: "list" (compact rows), "grid"
  // (photo-forward cards), "magazine" (large editorial section headers, more
  // breathing room), or "minimal" (text-only, ignores item photos even if
  // uploaded — fastest scan for a quick-service counter).
  menuLayout       String        @default("list")
  // Card presentation, layered on top of menuLayout — a JSON blob (not one
  // column each) since these five sub-choices are only ever read/written
  // together and never queried individually:
  //   imagePosition: "left" | "top" | "none"
  //   imageAspect:   "square" | "4:3" | "16:9"
  //   border:        "none" | "thin" | "bold"
  //   shadow:        "none" | "soft" | "lifted"
  //   divider:       "none" | "line" | "space"
  // Null = use menuLayout's own sensible defaults (see lib/menu-style.ts).
  cardStyle        Json?
  // compact | comfortable | large — scales item name/price/description text
  // size on top of the existing font PAIRING (fontTheme), which only chooses
  // the typeface, not its scale.
  typeScale        String        @default("comfortable")
  // plain | underline | pill | bold-caps — category header treatment.
  sectionHeaderStyle String      @default("plain")
  // pill | rounded | square — independent of cornerStyle, which governs
  // cards/dialogs; this is specifically the Add-to-cart / primary CTA shape.
  buttonShape      String        @default("rounded")
  // solid | outline | soft — the same buttons' fill treatment.
  buttonFill       String        @default("solid")
  // solid | pattern | photo — background treatment. "photo" is the existing
  // bgImageUrl upload; "pattern" picks one of a small built-in set (see
  // lib/menu-style.ts) tinted to the theme automatically, no upload needed.
  bgTreatment      String        @default("solid")
  bgPatternKey     String?
  // 0-100 — how strong the readability overlay is over a photo background.
  // Was a fixed value before; now the venue controls it because a busy photo
  // needs more overlay than a calm one, and a dark theme needs less than a
  // light one.
  bgOverlayStrength Int          @default(55)
  // QR styling (lib/qr.ts). Colours default to the venue's theme when unset
  // (null) rather than duplicating brandColor here.
  qrForegroundColor String?
  qrBackgroundColor String?
  qrCornerStyle    String        @default("square")
  qrEmbedLogo      Boolean       @default(false)
  // minimal | branded | bold — which printable table-card template QR
  // downloads (table QR, staff sign-in, kitchen screen) use by default.
  qrCardTemplate   String        @default("branded")
  // Optional social/web links shown on the customer ordering page footer.
  instagramHandle  String?
  websiteUrl       String?
  // Whether this venue uses Square today ("square" | "none" | null =
  // unanswered). Square is the only POS asked about — the only one with a
  // real integration on the roadmap (Delivery 1b). posProviderOther is
  // legacy from an earlier multi-brand picker and is no longer written.
  posProvider      String?
  posProviderOther String?
  // Captured intent to connect Square once that connection exists — settles
  // card payments into the venue's existing Square account and offers a
  // one-time menu import. Explicitly NOT order sync or ongoing menu sync.
  squareConnectInterest Boolean @default(false)
  // Card surcharge (spec: disclosed before confirm, its own line on the bill
  // and tax invoice, included in the GST calc). Off by default — AU venues
  // opt in. Stored in basis points (170 = 1.70%) for exact integer maths at
  // charge time; never a float.
  surchargeEnabled     Boolean @default(false)
  surchargeBasisPoints Int     @default(0)
  // Set once the onboarding wizard finishes. Backfilled to createdAt for rows
  // that predate the wizard so nobody is re-onboarded by this migration.
  onboardingCompletedAt DateTime?
  // Set when the owner completes OR skips the dashboard's guided tour
  // (components/tour). Distinct from onboardingCompletedAt: finishing the
  // wizard and having seen the tour are different things. Null = the tour
  // auto-starts on their first Overview visit; "Replay tour" ignores it.
  dashboardTourCompletedAt DateTime?
  // Whether this venue is actually serving customers — gates /v/[token] and
  // /m/[slug] (see lib/entitlements.ts#isOrgSubscribed and
  // dashboard/actions.ts#publishRestaurant). Distinct from
  // onboardingCompletedAt: finishing setup doesn't mean the org has an
  // active (mock) subscription yet, and publishRestaurant refuses to flip
  // this to true until it does. Defaults false so no existing restaurant is
  // silently "live" the moment this column lands.
  published      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  locations      Location[]
  menuCategories MenuCategory[]
  staffAccounts  StaffAccount[]
  tillzStands    TillzStand[]
  standOrders    StandOrder[]
  bills          Bill[]
  cashSessions   CashDrawerSession[]
  squareConnection SquareConnection?
  menuItemSquareMaps MenuItemSquareMap[]
  menuCategorySquareMaps MenuCategorySquareMap[]
  modifierGroupSquareMaps ModifierGroupSquareMap[]
  modifierOptionSquareMaps ModifierOptionSquareMap[]

  @@index([organizationId])
}

// A venue's connection to its own Square merchant account (OAuth, per venue —
// each restaurant connects its own Square, never shared across an org). This
// phase only stores the connection; it does not take payments or push orders
// (see src/lib/payments/ for the actual payment abstraction, left untouched).
// Token fields are AES-256-GCM ciphertext (src/lib/square/crypto.ts) — never
// plaintext, never returned to the client, never logged.
model SquareConnection {
  id              String     @id @default(cuid())
  restaurantId    String     @unique
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  merchantId      String
  // "sandbox" | "production" — mirrors SQUARE_ENV at the time this connection
  // was created, so a later env change doesn't silently reinterpret it.
  environment     String
  accessTokenEnc  String
  refreshTokenEnc String
  tokenExpiresAt  DateTime
  // Square location chosen for this venue, set after connecting (a merchant
  // can have several); null until the owner picks one in Settings.
  locationId      String?
  merchantName    String?
  scopes          String[]
  connectedByUserId String
  // Not set by the disconnect flow (which deletes the row after revoking at
  // Square) — set instead by the oauth.authorization.revoked webhook (Phase
  // 4) when the venue disconnects Tillz from the Square Dashboard side
  // rather than from Settings -> Integrations, so getVenuePaymentContext
  // stops treating this connection as usable without deleting the row.
  revokedAt       DateTime?
  // Set by importCatalog() (Phase 2) on a successful reconcile. Null = never
  // imported yet.
  lastCatalogSyncAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// Dedup record for /api/square/webhook (Phase 4) — Square retries webhook
// deliveries, so every verified event_id is recorded here before it's acted
// on; a retry of an already-processed event is a no-op. Deliberately NOT
// cascaded to anything and never read back except by eventId, so this never
// grows into a real event log.
model ProcessedSquareWebhook {
  id         String   @id @default(cuid())
  eventId    String   @unique
  type       String
  merchantId String?
  receivedAt DateTime @default(now())
}

// A Square OAuth result captured DURING onboarding, before the Restaurant it
// belongs to exists (SquareConnection is keyed by restaurantId, and the
// wizard only creates the restaurant at its very last step). Keyed by the
// signed-in user instead; completeOnboarding / completeOnboardingForExistingOrg
// move it onto the new restaurant as a real SquareConnection and delete this
// row in the same transaction. Same encrypted token columns and the same
// never-to-the-client rule as SquareConnection. Short-lived by design — it
// only exists between the wizard's Payments step and "Create my venue".
model PendingSquareConnection {
  userId          String   @id
  merchantId      String
  environment     String
  accessTokenEnc  String
  refreshTokenEnc String
  tokenExpiresAt  DateTime
  merchantName    String?
  scopes          String[]
  // Chosen in the wizard's Payments step (or auto-picked when the merchant
  // has exactly one). Copied onto SquareConnection.locationId on attach.
  locationId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Square catalog <-> Tillz menu id mappings (Phase 2 — import/reconcile only,
// no order-push yet). Each is unique on the Tillz id so re-importing updates
// the existing row instead of creating a duplicate mapping.
model MenuItemSquareMap {
  id                 String     @id @default(cuid())
  restaurantId       String
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId         String     @unique
  menuItem           MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  squareItemId       String
  squareVariationId  String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([restaurantId])
}

model MenuCategorySquareMap {
  id               String       @id @default(cuid())
  restaurantId     String
  restaurant       Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId       String       @unique
  category         MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  squareCategoryId String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([restaurantId])
}

model ModifierGroupSquareMap {
  id                    String         @id @default(cuid())
  restaurantId          String
  restaurant            Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifierGroupId       String         @unique
  modifierGroup         ModifierGroup  @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  squareModifierListId  String
  createdAt             DateTime       @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([restaurantId])
}

model ModifierOptionSquareMap {
  id                String          @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifierOptionId  String          @unique
  modifierOption    ModifierOption  @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)
  squareModifierId  String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([restaurantId])
}

// In-progress onboarding wizard answers, keyed by the Supabase auth user id.
// Exists only because no Restaurant/Organization/Membership row exists yet at
// this point — the whole wizard is answered before completeOnboarding creates
// them all atomically in one transaction. Deleted the moment onboarding
// completes, in that same transaction. Lets a mid-wizard refresh resume with
// every selection intact.
model OnboardingDraft {
  userId    String   @id
  answers   Json
  updatedAt DateTime @updatedAt
}

// A physical site. Tables hang off Location.
model Location {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  addressLine  String?
  suburb       String?
  state        String?
  postcode     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tables       Table[]
  bills        Bill[]
  cashSessions CashDrawerSession[]

  @@index([restaurantId])
}

// A physical table at a location. Soft-deactivated, not deleted, so historical
// bills keep their reference.
model Table {
  id         String    @id @default(cuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  label      String
  section    String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  qrTokens   QrToken[]
  bills      Bill[]
  requests   CustomerRequest[]
  tillzStands TillzStand[]
  standOrderItems StandOrderItem[]

  @@index([locationId])
}

// A physical Tillz stand (the printed table-top card with a QR code).
// Distinct fields for distinct audiences, deliberately: `id` is the internal
// PK (never shown anywhere); `qrToken` is the high-entropy value encoded in
// the printed QR (/s/<qrToken> — see lib/stands.ts#resolveStand), never
// sequential, so it can't be enumerated; `serial` is the human-readable
// label ("TZ-000123") a staff member reads off the physical card and types
// in to activate it — never put in a URL.
//
// Lifecycle: minted UNCLAIMED (org+restaurant known, no table yet) when a
// StandOrder is paid — see the order/fulfilment addendum. A staff member
// activates it on arrival by typing its serial into the dashboard's
// "Activate a stand" flow and picking the table it's physically going on;
// that's what sets tableId and flips status to ACTIVE, and is the ONLY way
// a stand ever gets bound to a table (never automatic on ship/print).
// Reassignability: /s/<qrToken> always resolves to whatever table this row's
// tableId CURRENTLY points at, so moving an already-active stand to a
// different table needs no reprint.
enum StandStatus {
  UNCLAIMED
  ACTIVE
  DEACTIVATED
}

model TillzStand {
  id             String      @id @default(cuid())
  serial         String      @unique
  qrToken        String      @unique
  status         StandStatus @default(UNCLAIMED)
  organizationId String?
  restaurantId   String?
  restaurant     Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  tableId        String?
  table          Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orderId        String?
  order          StandOrder?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem      StandOrderItem?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
  @@index([orderId])
}

// A venue's paid order for physical Tillz stands — one StandOrderItem per
// table they chose. Mints one UNCLAIMED TillzStand per item the moment
// payment succeeds (see lib/stand-orders.ts); the admin fulfilment queue
// (addendum task 4) prints/ships those, and a staff member later activates
// each one on arrival via the existing serial-entry flow — this model never
// sets a stand's tableId itself.
enum StandOrderStatus {
  PENDING_PAYMENT
  PAID
  PRINTED
  SHIPPED
}

// QR vs NFC is display/labelling only — both resolve through the exact same
// /s/<qrToken> flow (lib/stands.ts), never a backend fork.
enum StandType {
  QR
  NFC
}

// Admin-managed catalog listing a venue picks from on the "Order Tillz
// stands" screen (dashboard/stands). Never hard-deleted — retiring one only
// sets active=false, since a past StandOrder can still reference it (see
// StandOrder.standProductId) and must keep resolving for order history.
model StandProduct {
  id          String     @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  type        StandType
  priceCents  Int
  active      Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  standOrders StandOrder[]

  @@index([active, sortOrder])
}

model StandOrder {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurantId   String
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  status         StandOrderStatus @default(PENDING_PAYMENT)
  standProductId String?
  standProduct   StandProduct?    @relation(fields: [standProductId], references: [id], onDelete: SetNull)
  // Snapshot of the product at order time — survives the product later being
  // edited or retired (active=false), so a historical order still shows what
  // was actually bought rather than whatever the catalog says today.
  productTitleSnapshot String?
  productType          StandType?
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  shippingName    String
  shippingAddress String
  shippingSuburb  String
  shippingState   String
  shippingPostcode String
  paidAt         DateTime?
  printedAt      DateTime?
  shippedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          StandOrderItem[]
  stands         TillzStand[]

  @@index([organizationId])
  @@index([restaurantId])
  @@index([status])
}

model StandOrderItem {
  id         String     @id @default(cuid())
  orderId    String
  order      StandOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tableId    String
  table      Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  standId    String?     @unique
  stand      TillzStand? @relation(fields: [standId], references: [id])
  createdAt  DateTime   @default(now())

  @@index([orderId])
  @@index([tableId])
}

// An opaque, revocable token mapping a scanned QR to a table (spec §25, §126).
model QrToken {
  id        String    @id @default(cuid())
  token     String    @unique
  tableId   String
  table     Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([tableId])
  @@index([token])
}

// Menu is attached at the restaurant level for now (single location). When
// multi-location menus land, a locationId scope is added here.
model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  // Availability window (venue-local "HH:MM"). Null/null = always available.
  availableFrom String?
  availableTo   String?
  // Which prep station this category routes to (e.g. "kitchen", "bar",
  // "coffee"). Null = the default kitchen board. Individual items can
  // override this — see MenuItem.station.
  station       String?
  // A single emoji shown next to the category name on the customer menu
  // (e.g. "☕"). Purely cosmetic, no upload required — the fastest way for a
  // venue to make a category feel like theirs.
  icon          String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]
  squareMap    MenuCategorySquareMap?

  @@index([restaurantId])
}

model MenuItem {
  id          String       @id @default(cuid())
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priceCents  Int
  imageUrl    String?
  available   Boolean      @default(true)
  allergens   String[]     @default([])
  // Small merchandising tags — "popular", "new", "chefs_pick", "spicy",
  // "vegetarian", "vegan", "gluten_free" (see lib/menu-badges.ts for the
  // canonical list). Shown as coloured chips on the customer menu.
  badges      String[]     @default([])
  // Per-item prep station override — null means "use the category's
  // station" (see MenuCategory.station). Lets one item in an otherwise
  // kitchen-routed category go to a different board, e.g. a coffee-flavoured
  // dessert still going to the barista.
  station     String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  billItems   BillItem[]
  modifierGroups ModifierGroup[]
  squareMap   MenuItemSquareMap?

  @@index([categoryId])
}

// A group of choices attached to a menu item, e.g. "Sauce" or "Extras" (spec
// §27). required + maxSelect drive validation: required means at least one must
// be chosen; maxSelect caps how many (1 = single choice, 0 = unlimited).
model ModifierGroup {
  id         String           @id @default(cuid())
  menuItemId String
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  required   Boolean          @default(false)
  maxSelect  Int              @default(1)
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  options    ModifierOption[]
  squareMap  ModifierGroupSquareMap?

  @@index([menuItemId])
}

model ModifierOption {
  id             String        @id @default(cuid())
  groupId        String
  group          ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name           String
  priceDeltaCents Int          @default(0)
  sortOrder      Int           @default(0)
  createdAt      DateTime      @default(now())
  squareMap      ModifierOptionSquareMap?

  @@index([groupId])
}

// A table's running tab. At most one OPEN bill per table at a time (enforced in
// the bill service). Totals are always recomputed server-side from BillItem
// rows — the client is never trusted with an amount (spec §15, §145).
// DINE_IN is a table order (customer or staff-placed); COUNTER is a
// staff-run cashier sale with no table (see lib/bills.ts#createCounterBill);
// TAKEAWAY is reserved for future use — not created anywhere yet.
enum BillChannel {
  DINE_IN
  COUNTER
  TAKEAWAY
}

model Bill {
  id             String     @id @default(cuid())
  // Nullable: a COUNTER bill has no table at all. DINE_IN bills always have
  // one — enforced by application code (createCounterBill vs. the table
  // order flow), not a DB constraint, since Prisma can't express "required
  // unless channel = X".
  tableId        String?
  table          Table?     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  // Direct restaurant/location scoping so revenue queries (analytics,
  // invoices) don't have to go through the (now-optional) table relation to
  // find a counter bill's venue — see lib/analytics.ts, lib/invoices.ts.
  // Nullable only because this column landed after existing rows; every
  // bill created from here on always sets both (see lib/bills.ts).
  restaurantId   String?
  restaurant     Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  channel        BillChannel @default(DINE_IN)
  status         BillStatus @default(OPEN)
  currency       String     @default("AUD")
  subtotalCents  Int        @default(0)
  discountCents  Int        @default(0)
  totalCents     Int        @default(0)
  amountPaidCents Int       @default(0)
  tipCents       Int        @default(0)
  // Cumulative amount refunded across all this bill's payments — display/
  // reconciliation only. Refunds never change `status` or `paidAt` (a
  // refund is a reversal on a settled bill, not a reopened tab — see
  // refundPayment in lib/bills.ts for why that matters against the
  // one-open-bill-per-table index).
  refundedCents  Int        @default(0)
  customerName   String?
  // Historical contact field, E.164 (+61...). Nothing writes this anymore —
  // it used to be captured for a customer notification feature that has
  // since been removed entirely; existing rows are kept read-only for
  // analytics/invoice history (see lib/analytics.ts, lib/invoices.ts).
  customerPhone  String?
  // Last email address a receipt was sent to, and when — lets the venue see
  // whether/where a copy went out, and pre-fills the "email me a copy" form
  // on repeat requests. Never required; a bill can be paid with no email.
  receiptEmail      String?
  receiptEmailSentAt DateTime?
  // Square Order id (Phase 3), set on each successful Square-connected
  // payment against this bill — a split-paid bill can charge through several
  // Square Orders over time, so this always holds the MOST RECENT one; the
  // authoritative per-charge record is Payment.squareOrderId below.
  squareOrderId  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  paidAt         DateTime?
  items          BillItem[]
  payments       Payment[]
  orders         Order[]

  @@index([tableId])
  @@index([paidAt])
  // The actual shape of the app's single most common query — the customer
  // page and the staff table page both do WHERE tableId = ? AND status IN
  // (OPEN, PARTIALLY_PAID) on every load. The separate single-column indexes
  // above don't combine into this as efficiently as one index that matches
  // it directly.
  @@index([tableId, status])
  // Analytics, invoices, and the weekly report all filter WHERE status =
  // PAID AND paidAt BETWEEN ? AND ? — replaces the standalone `status` index
  // (a strict prefix of this one, so nothing that used it loses coverage).
  @@index([status, paidAt])
  // Revenue queries rerouted to scope by Bill.restaurantId/locationId
  // directly (counter bills have no table to reach a restaurant through) —
  // see lib/analytics.ts, lib/invoices.ts.
  @@index([restaurantId, status, paidAt])
  @@index([locationId, status])
}

// A line on a bill. name and unitPriceCents are SNAPSHOTS taken when the item
// was added, so a later menu price change never rewrites history (spec §105,
// §107). menuItemId is kept for reporting but is nullable-safe via SetNull.
model BillItem {
  id             String    @id @default(cuid())
  billId         String
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  menuItemId     String?
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  nameSnapshot   String
  unitPriceCents Int
  modifiers      Json?
  quantity       Int       @default(1)
  // How many units of this line have been settled via item-split payment. Lets
  // each person pay for their own items without double-paying the same unit.
  paidQuantity   Int       @default(0)
  // Staff bill adjustments: a voided line is removed from the total; a comped
  // line stays on the ticket but is charged at $0.
  voided         Boolean   @default(false)
  comped         Boolean   @default(false)
  // Prep station snapshot (from the item's category) for kitchen routing.
  station        String?
  // Free-text customer annotation on this specific line, e.g. "no fries" —
  // distinct from Order.note, which is one note for the whole send.
  note           String?
  lineTotalCents Int
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([billId])
  @@index([orderId])
}

// An order ticket: a batch of items sent to the kitchen at one time. Its items
// are BillItems (linked via orderId), so the bill total is unaffected — an Order
// is a grouping + a cook status over those lines (spec §9). restaurantId and
// tableId are denormalized so the kitchen screen can query without deep joins.
model Order {
  id           String      @id @default(cuid())
  billId       String
  bill         Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  // Nullable: a counter sale has no table. Plain scalar, no Prisma relation
  // (Order never declared a `table` relation field to begin with) — see
  // lib/bills.ts#addItemsToCounterBill (tableId: null) vs. the table order
  // flow (always sets it).
  tableId      String?
  restaurantId String
  status       OrderStatus @default(SUBMITTED)
  source       OrderSource @default(CUSTOMER)
  orderNumber  Int?
  // Release gates. While either is true the order is PENDING and the kitchen
  // never sees it. Cleared by staff acceptance / by payment respectively; when
  // both are false the order is released to the kitchen (SUBMITTED).
  awaitingApproval Boolean @default(false)
  awaitingPayment  Boolean @default(false)
  // True for a ticket created by re-firing already-billed item(s) — a dropped
  // plate or a send-back that needs re-cooking. Its BillItems are re-pointed
  // from their original order rather than duplicated, so the bill is
  // completely unaffected either way; this flag exists purely so the kitchen
  // screen can badge it distinctly from a fresh order.
  isRefire     Boolean     @default(false)
  note         String?
  // Idempotency: the client sends a stable id per "place order" tap so a
  // double-tap or a retried request can never create the same order twice.
  clientRequestId String?  @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  servedAt     DateTime?
  items        BillItem[]
  // Which prep stations have confirmed THEIR portion of this ticket served.
  // A multi-station order (e.g. grill + bar items on one ticket) shares one
  // Order.status — advanceOrderStatus used to let ANY single station's
  // "Mark served" button flip the WHOLE order to SERVED, instantly removing
  // it from getKitchenOrders for every other station even if their items
  // were never touched. For a multi-station order, advanceOrderStatus now
  // only actually transitions to SERVED once every station represented
  // among the order's items appears here; until then it records the
  // station's confirmation and leaves status (and the ticket's visibility
  // to the remaining stations) unchanged. Irrelevant for a single-station
  // order, where the original whole-order behavior is preserved exactly.
  stationsServed String[]  @default([])

  // Covers getKitchenOrders' WHERE restaurantId = ? AND status IN (...)
  // ORDER BY createdAt — the exact shape of every kitchen-screen load.
  @@index([restaurantId, status, createdAt])
  // Covers getRecentlyServed's WHERE restaurantId = ? AND status = SERVED
  // AND servedAt >= ? ORDER BY servedAt DESC — the other query every kitchen
  // page load runs. Separate from the index above since the trailing sort
  // column differs (createdAt vs servedAt); one composite index can't serve
  // both efficiently.
  @@index([restaurantId, status, servedAt])
  @@index([billId])
}

// A payment attempt against a bill. providerRef ties back to the payment
// provider; idempotencyKey guards against double submission (spec §15, §146).
model Payment {
  id             String        @id @default(cuid())
  billId         String
  bill           Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  amountCents    Int
  tipCents       Int           @default(0)
  // Card surcharge charged on top of amountCents+tipCents for this specific
  // payment (spec: surcharge is a property of the transaction, so it's
  // tracked per-payment rather than pre-baked into the bill total — this
  // also makes it correct under split payments, where each payer's own
  // charge carries its own surcharge).
  surchargeCents Int           @default(0)
  currency       String        @default("AUD")
  status         PaymentStatus @default(PENDING)
  provider       String        @default("mock")
  providerRef    String?
  // The Square Order this payment was charged against (Phase 3) — null for
  // every mock-provider payment and for anything predating this column.
  squareOrderId  String?
  idempotencyKey String        @unique
  // Cached running total of successful refunds against this payment. Kept in
  // sync via the same compare-and-swap pattern as Bill.amountPaidCents.
  refundedCents  Int           @default(0)
  // Where the money physically is once the processor pays the venue out.
  // Populated by a payout/transfer webhook once real processors land; stays
  // null under the mock provider.
  payoutStatus   String?
  test           Boolean       @default(true)
  // Cash/card/other split for a counter payment — nullable since an online/
  // customer payment (payBillAmount, payBillItems) never sets this; only the
  // staff counter path (staffCloseBill, staffCloseBillById) does. See
  // lib/cash-drawer.ts.
  tenderType     TenderType?
  // Which open drawer session this payment landed in, if any was open at the
  // time — a CASH tender requires one (see lib/bills.ts's tender check);
  // CARD/OTHER attach one when present but don't require it. Nullable so
  // existing rows and non-counter payments stay unaffected.
  cashSessionId  String?
  cashSession    CashDrawerSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  refunds        Refund[]

  @@index([billId])
  @@index([cashSessionId])
}

// A refund against a specific payment (never against the bill in aggregate —
// so it always ties back to a real processor payment id for reconciliation).
// Full or partial; amountCents can be less than the payment's total so a
// venue can refund, say, just one item's worth without touching the rest.
model Refund {
  id             String       @id @default(cuid())
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents    Int
  reason         String
  status         RefundStatus @default(PENDING)
  provider       String
  providerRef    String?
  idempotencyKey String       @unique
  actorUserId    String
  actorEmail     String
  test           Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([paymentId])
}

enum TenderType {
  CASH
  CARD
  OTHER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  PAID_IN
  PAID_OUT
}

// One shift's cash drawer at one location — opened with a starting float,
// closed with a physical cash count reconciled against what the system
// expected (see lib/cash-drawer.ts#getZReport). At most one OPEN session per
// location at a time (enforced in application code by openSession, not a DB
// constraint — a partial unique index on (locationId) WHERE status = 'OPEN'
// would be the stronger guard if this ever needs the same race-proofing as
// one-open-bill-per-table.sql).
model CashDrawerSession {
  id                String            @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  locationId        String
  location          Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  openedByStaffId   String
  openedByName      String
  openedAt          DateTime          @default(now())
  openingFloatCents Int
  status            CashSessionStatus @default(OPEN)
  closedByStaffId   String?
  closedByName      String?
  closedAt          DateTime?
  // The physical cash count staff entered at close — compared against
  // getZReport's expectedCashCents to produce the over/short variance.
  // Null while the session is still open.
  countedCashCents  Int?
  note              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  payments          Payment[]
  movements         CashMovement[]

  @@index([restaurantId, status])
  @@index([locationId, status])
}

// A paid-in (e.g. petty cash added to the drawer) or paid-out (e.g. a safe
// drop, or cash paid out for a small supply run) adjustment against an open
// drawer — folded into getZReport's expectedCashCents alongside sales/refunds.
model CashMovement {
  id            String            @id @default(cuid())
  cashSessionId String
  cashSession   CashDrawerSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type          CashMovementType
  amountCents   Int
  reason        String
  staffId       String
  staffName     String
  createdAt     DateTime          @default(now())

  @@index([cashSessionId])
}

// A pending invitation for someone to join an organization with a role. The
// opaque token is the accept link (/invite/{token}); it expires and can be
// revoked (spec §85). On acceptance a Membership is created.
model StaffInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(STAFF)
  token          String       @unique
  status         InviteStatus @default(PENDING)
  invitedByEmail String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([token])
  @@index([email])
}

// Immutable record of a significant action (spec §58). Kept per organization so
// the activity view is naturally tenant-scoped.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String
  actorEmail     String
  action         String
  resourceType   String?
  resourceId     String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// A PIN-based staff login, scoped to one restaurant. Separate from Membership
// (which is for Supabase email/password accounts). Floor staff pick their name
// and enter a numeric PIN. pinHash is scrypt-salted; the raw PIN is shown to the
// owner once at creation/reset and never stored. failedAttempts/lockedUntil
// implement online brute-force lockout.
model StaffAccount {
  id             String     @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name           String
  role           Role       @default(STAFF)
  // Locks a KITCHEN-role account to one prep station (from
  // Restaurant.kitchenStations) — on login it goes straight to that
  // station's board instead of the shared kitchen screen, and the kitchen
  // page enforces the filter server-side rather than trusting the URL, so
  // it's a real per-station device, not just a bookmarked filter. Null (the
  // default, and the only sensible value for non-KITCHEN roles) sees every
  // station, same as today.
  assignedStation String?
  pinHash        String
  active         Boolean    @default(true)
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([restaurantId])
}

// A table-service request raised by a customer from their phone (spec §42):
// water, cutlery, the bill, general assistance, or a free-text note. Staff
// acknowledge then complete it. restaurantId is denormalized for staff queries.
model CustomerRequest {
  id             String        @id @default(cuid())
  tableId        String
  table          Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  restaurantId   String
  type           RequestType
  note           String?
  status         RequestStatus @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  acknowledgedAt DateTime?
  completedAt    DateTime?

  @@index([restaurantId, status])
  @@index([tableId])
}

// Links a Supabase auth user to an organization with a role. Tenant boundary.
model Membership {
  id             String       @id @default(cuid())
  userId         String       // Supabase auth.users.id (UUID)
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @default(OWNER)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

