# Supabase — from your project dashboard.
# Settings → API Keys  (publishable is browser-safe; secret is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional but recommended. Signs the staff PIN session cookie. Without it,
# SUPABASE_SECRET_KEY (your database/storage admin key) is reused for signing
# instead — set this to any long random string to keep the two separate.
# Generate one with: openssl rand -base64 32
# STAFF_SESSION_SECRET=

# Postgres — Connect → ORM → Prisma
# DATABASE_URL is the pooled connection (port 6543); DIRECT_URL is direct (5432).
DATABASE_URL="postgresql://postgres.your-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Optional. Public base URL used to build QR/NFC/invite/auth links.
#  - Local dev: defaults to http://localhost:3000. To scan with a real phone on
#    your LAN, set it to a phone-reachable URL (your LAN IP or a tunnel).
#  - On Vercel you DON'T need this — links auto-resolve to the deployment
#    (VERCEL_PROJECT_PRODUCTION_URL, falling back to VERCEL_URL for previews).
#    Set it only to pin links to a custom domain; when set, it always wins.
# NEXT_PUBLIC_APP_URL=https://tillz.example.com

# Email (Resend) — optional. Without these, email runs in mock mode: nothing
# is sent, receipts just log server-side. Add both to email real receipt
# copies to customers. RESEND_FROM must be a sender verified on your Resend
# account, e.g. "Tillz <receipts@yourdomain.com>".
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=Tillz <receipts@yourdomain.com>

# Support contact shown on /support. Optional — without these the page says
# plainly that support isn't configured yet, rather than showing a fake address.
# SUPPORT_EMAIL=support@yourdomain.com
# SUPPORT_PHONE=+61280001234

# Off by default. The /dashboard/billing checkout form is a MOCK that collects
# a raw card number and never should on a real deployment — leave this unset
# (or false) until real Stripe Billing replaces that form outright.
# BILLING_UI_ENABLED=true

# ABN verification (Settings → verify a venue's ABN against the Australian
# Business Register). Optional — without it, ABN lookups run in mock mode: the
# checksum is still validated for real, but the returned "registered entity"
# is a clearly-labelled placeholder. Register for a free GUID at
# https://abr.business.gov.au/Tools/WebServices
# ABR_GUID=00000000-0000-0000-0000-000000000000

# Platform-admin (super-admin) allowlist for /admin — the ONLY source of admin
# truth in the app (see src/lib/platform-admin.ts). Comma-separated Supabase
# Auth user UUIDs (find a user's id in Supabase → Authentication → Users).
# No DB flag or client-controllable value can ever grant this access — if a
# user's id isn't in this exact list, /admin doesn't exist for them.
# PLATFORM_ADMIN_USER_IDS=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222

# Square OAuth (per-venue POS connection — Settings → Integrations). Required
# only once a venue actually connects Square; without these the connect flow
# throws a clear "missing env var" error rather than failing silently.
# SQUARE_ENV=sandbox
# From your Square Developer Dashboard → your app → Credentials.
# SQUARE_APPLICATION_ID=sandbox-sq0idb-xxxxxxxxxxxxxxxxxxxxxx
# SQUARE_APPLICATION_SECRET=sandbox-sq0csb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must exactly match a Redirect URL configured on the Square app, e.g.
# https://your-app.example.com/api/square/callback
# SQUARE_REDIRECT_URL=http://localhost:3000/api/square/callback
# 32-byte key, base64-encoded, for AES-256-GCM token encryption. Generate one
# with: openssl rand -base64 32
# SQUARE_TOKEN_ENC_KEY=
# Tillz's application fee on Square-connected card payments, in basis points
# of the goods amount (e.g. 150 = 1.50%). Optional — defaults to 0 (no fee).
# SQUARE_APP_FEE_BPS=0
